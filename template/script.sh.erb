echo "Running script.sh.erb script"

# --- TOKEN DEBUG -------------------------------------------------------------
# HEADER_PROXY=1 puts a small logging proxy on 8080 in front of Fluent (moved to
# 8081). It logs the Authorization header each browser request arrives with, so
# we can see what OnDemand forwards. WebSockets are not proxied, so the Fluent
# UI will not fully work past sign-in while this is on.
HEADER_PROXY=1
# -----------------------------------------------------------------------------

echo "module purge"
module purge

# load ansys Server
echo "module load"
echo "member of groups: $(groups)"
module load ANSYS/<%= context.ansysver %>

export ANSOFTD_LICENSE_FILE=$(awk -F= '/^SERVER=/ {print $2}'  <%= context.ansyslic %>)
export ANSYSLMD_LICENSE_FILE=$ANSOFTD_LICENSE_FILE

echo "ANSYSLMD_LICENSE_FILE=$ANSOFTD_LICENSE_FILE"

# Until taken out of module file
module unload Qt5

TMPDIR="$(mktemp -d)"

# TOKEN DEBUG: is the token still in this shell after the module commands?
if [[ -n "${FLUENT_WEBSERVER_TOKEN:-}" ]]; then
  echo "[token-debug] script.sh: FLUENT_WEBSERVER_TOKEN is set (${#FLUENT_WEBSERVER_TOKEN} chars)"
else
  echo "[token-debug] script.sh: FLUENT_WEBSERVER_TOKEN is NOT set after module load"
fi

# TOKEN DEBUG: runs once the web server answers on 8080, then reports
#   1. whether each Fluent/cortex process has the token in its environment,
#   2. any mention of a token in the transcript,
#   3. files Fluent wrote in ~/.ansys, ~/.fluent* or the output directory at start-up.
token_debug() {
  { set +x; } 2>/dev/null
  local start=$SECONDS
  until (echo > /dev/tcp/127.0.0.1/$FLUENT_PORT) 2>/dev/null; do
    if (( SECONDS - start > 900 )); then
      echo "[token-debug] gave up waiting for port $FLUENT_PORT"
      return
    fi
    sleep 5
  done
  echo "[token-debug] port $FLUENT_PORT is open after $((SECONDS - start))s"
  # Give SimBA a moment to finish starting.
  sleep 10

  echo "[token-debug] --- 1. process environments ---"
  local found=0 p cmd exe val state
  for p in /proc/[0-9]*; do
    cmd=$( { tr '\0' ' ' < "$p/cmdline"; } 2>/dev/null ) || continue
    # Match on the executable name only: the output directory path contains
    # "fluent-server", so matching the whole command line catches bash too.
    exe=$(basename "${cmd%% *}" 2>/dev/null)
    [[ "$exe" == cortex* || "$exe" == fluent* ]] || continue
    found=1
    val=$( { tr '\0' '\n' < "$p/environ"; } 2>/dev/null | sed -n 's/^FLUENT_WEBSERVER_TOKEN=//p')
    if [[ -z "$val" ]]; then
      state="MISSING"
    elif [[ "$val" == "$FLUENT_WEBSERVER_TOKEN" ]]; then
      state="matches"
    else
      state="DIFFERENT value"
    fi
    echo "[token-debug] pid ${p#/proc/} ${state}: ${cmd:0:120}"
  done
  (( found )) || echo "[token-debug] no fluent/cortex processes found"

  # SimBA (the Python/uvicorn web server Fluent starts) is what checks the
  # token. Show how it was launched and any token-like variables it has.
  echo "[token-debug] --- 1b. SimBA web server process ---"
  found=0
  local name value shown simba_exe=""
  for p in /proc/[0-9]*; do
    cmd=$( { tr '\0' ' ' < "$p/cmdline"; } 2>/dev/null ) || continue
    [[ "$cmd" == *[Ss]im[Bb][Aa]* || "$cmd" == *uvicorn* ]] || continue
    [[ "$cmd" == *token_debug* || "$cmd" == *grep* ]] && continue
    found=1
    simba_exe="${cmd%% *}"
    echo "[token-debug] pid ${p#/proc/} cmdline: ${cmd:0:800}"
    { tr '\0' '\n' < "$p/environ"; } 2>/dev/null \
      | grep -i -E '^[^=]*(token|simba|auth|passw|secret|key|webserver|_ws)[^=]*=' \
      | while IFS='=' read -r name value; do
          if [[ "$value" == "$FLUENT_WEBSERVER_TOKEN" ]]; then
            shown="= our token"
          elif [[ -z "$value" ]]; then
            shown="(empty)"
          else
            shown="${value:0:4}... (${#value} chars)"
          fi
          echo "[token-debug]   env $name $shown"
        done
  done
  (( found )) || echo "[token-debug] no SimBA/uvicorn process found"

  # Call SimBA directly (no OnDemand proxy) with the token sent different ways.
  echo "[token-debug] --- 1d. direct ping, bypassing OnDemand ---"
  if command -v curl > /dev/null; then
    local url="http://127.0.0.1:$FLUENT_PORT/api/connection/ping" t="$FLUENT_WEBSERVER_TOKEN"
    ping_try() {
      local label=$1; shift
      local out
      out=$(curl -s -m 10 -w ' HTTP %{http_code}' -X POST "$@" 2>/dev/null)
      echo "[token-debug]   ${label}: ${out:0:200}"
    }
    # The web UI sends sha256(password) as a Bearer token.
    local h
    h=$(printf '%s' "$t" | sha256sum | cut -d' ' -f1)
    ping_try "Bearer sha256(token)" -H "Authorization: Bearer $h" "$url"
    ping_try "Bearer sha256(token\\n)" -H "Authorization: Bearer $(printf '%s\n' "$t" | sha256sum | cut -d' ' -f1)" "$url"
    ping_try "Bearer sha256(sha256)" -H "Authorization: Bearer $(printf '%s' "$h" | sha256sum | cut -d' ' -f1)" "$url"
    # SimBA also inherits PASSWORD from the job script; rule it in or out.
    if [[ -n "${PASSWORD:-}" ]]; then
      ping_try "Bearer PASSWORD     " -H "Authorization: Bearer $PASSWORD" "$url"
      ping_try "Bearer sha256(PASSWD)" -H "Authorization: Bearer $(printf '%s' "$PASSWORD" | sha256sum | cut -d' ' -f1)" "$url"
    else
      echo "[token-debug]   PASSWORD not set in this shell, skipping PASSWORD pings"
    fi
    ping_try "no token            " "$url"
    ping_try "Authorization Bearer" -H "Authorization: Bearer $t" "$url"
    ping_try "Authorization plain " -H "Authorization: $t" "$url"
    ping_try "?token= query       " "$url?token=$t"
    ping_try "cookie token=       " -b "token=$t" "$url"
    ping_try "JSON body token     " -H 'Content-Type: application/json' -d "{\"token\":\"$t\"}" "$url"
    ping_try "JSON body password  " -H 'Content-Type: application/json' -d "{\"password\":\"$t\"}" "$url"
  else
    echo "[token-debug] curl not available, skipping"
  fi
  echo "[token-debug] SimBA log lines about tokens/passwords:"
  grep -h -i -E 'token|password|auth' ./simba-fluent-*.log 2>/dev/null | tail -20 | sed 's/^/[token-debug]   /'

  echo "[token-debug] --- 2. transcript ---"
  grep -i -n -e token -e "web server" -e password ./*.trn 2>/dev/null \
    || echo "[token-debug] no token/password lines in transcript"

  echo "[token-debug] --- 3. files written since start-up ---"
  find "$HOME/.ansys" "$HOME"/.fluent* . -type f -newer "$TMPDIR" 2>/dev/null \
    | grep -v -e '\.trn$' -e 'pod\.log$' \
    | while read -r f; do
        echo "[token-debug] $f"
        grep -i -l -e token -e password "$f" 2>/dev/null | sed 's/^/[token-debug]   mentions token\/password: /'
      done
  echo "[token-debug] done"
}

# Launch the Fluent Server
echo "Starting up Fluent..."

# ANSYS will loop over every possible file descriptor before starting.
# Limit must be small to avoid this taking forever.
ulimit -n  16384

FLUENT_PORT=8080

# TOKEN DEBUG: logging proxy on 8080 -> Fluent on 8081.
if [[ "$HEADER_PROXY" == "1" ]]; then
  PY=$(command -v python3 || ls /opt/nesi/share/ANSYS/v*/commonfiles/CPython/3_10/linx64/Release/python/bin/python3 2>/dev/null | head -1)
  if [[ -n "$PY" ]]; then
    FLUENT_PORT=8081
    PROXY_PY="$TMPDIR/header_proxy.py"
    cat > "$PROXY_PY" <<'EOF'
import hashlib, http.client, os, sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

UPSTREAM = int(sys.argv[1])
TOKEN = os.environ.get("FLUENT_WEBSERVER_TOKEN", "")
EXPECTED = "Bearer " + hashlib.sha256(TOKEN.encode()).hexdigest()
HOP = {"connection", "keep-alive", "te", "trailers", "transfer-encoding", "upgrade", "proxy-connection"}

def describe(auth):
    if auth is None:
        return "MISSING"
    if auth == EXPECTED:
        return "= Bearer sha256(token)  [correct]"
    return "DIFFERENT: %r... (%d chars)" % (auth[:15], len(auth))

class H(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    def log_message(self, *a):
        pass
    def handle_any(self):
        if self.path.startswith("/api/"):
            print("[token-debug] proxy %s %s  Authorization: %s" % (
                self.command, self.path, describe(self.headers.get("Authorization"))), flush=True)
            print("[token-debug]   header names: %s" % ", ".join(sorted(self.headers.keys())), flush=True)
        if self.headers.get("Upgrade"):
            self.send_response(502); self.send_header("Content-Length", "0"); self.end_headers()
            return
        n = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(n) if n else None
        hdrs = {k: v for k, v in self.headers.items() if k.lower() not in HOP}
        try:
            c = http.client.HTTPConnection("127.0.0.1", UPSTREAM, timeout=300)
            c.request(self.command, self.path, body=body, headers=hdrs)
            r = c.getresponse()
            data = r.read()
        except Exception as e:
            self.send_response(502); self.send_header("Content-Length", "0"); self.end_headers()
            return
        if self.path.startswith("/api/"):
            print("[token-debug]   -> upstream HTTP %d" % r.status, flush=True)
        self.send_response(r.status)
        for k, v in r.getheaders():
            if k.lower() not in HOP and k.lower() != "content-length":
                self.send_header(k, v)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(data)
    do_GET = do_POST = do_PUT = do_DELETE = do_PATCH = do_OPTIONS = do_HEAD = handle_any

ThreadingHTTPServer(("0.0.0.0", 8080), H).serve_forever()
EOF
    echo "[token-debug] header proxy: $PY on 8080 -> Fluent on 8081"
    "$PY" -I "$PROXY_PY" 8081 &
  else
    echo "[token-debug] header proxy: no python3 found, running without it"
  fi
fi

# Run the checks in the background; Fluent stays in the foreground.
token_debug &

CMD="fluent <%= context.is3d %><%= context.prescision %> <%= context.ismeshing %> -ws -g -ws-port=$FLUENT_PORT -ws-portspan=0"
set -x
echo "$CMD"
$CMD
