<%-
  # The token reaches the view as `fwtoken` (connection.yml) or, if OnDemand
  # reads the pod secret instead, as `password` (see before.sh.erb).
  token = fwtoken.to_s.empty? ? password.to_s : fwtoken.to_s
-%>
<form action="/rnode/<%= host %>/<%= port %>/" method="get" target="_blank">
  <input type="hidden" name="fluent-auth-token" value="<%= token %>"/>
  <input type="hidden" name="fw-auth-token" value="<%= token %>"/>
  <button class="btn btn-primary" style="background-color:#ffb71c; border-color: black; color: black" type="submit">
    <i class="fa-solid fa-mound"></i> Connect
  </button>
</form>
