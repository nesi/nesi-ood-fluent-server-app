<script>
function launchFluent() {

  // Create new window.
  const w = window.open("about:blank", "_blank");

  // Preload session storage before app boots. Fluent's sign-in form reads
  // sessionStorage "password" and sends sha256(password) as a Bearer token.
  // The token comes from the pod secret's `password` key (see before.sh.erb).
  const token = "<%= password %>";
  if (token) {
    w.sessionStorage.setItem("password", token);
  } else {
    // Clear any stale value from an earlier session.
    w.sessionStorage.removeItem("password");
  }
  w.location = "/rnode/<%= host %>/<%= port %>/"

  // Timer, wait for DOM to load.
  const timer = setInterval(() => {
    // server laggy try catch because sometimes fails.
    try {
      // Prevent infinite polling if window closed.
      if (!w || w.closed) {
        clearInterval(timer);
        return;
      }

      const btn = w.document.querySelector('[data-testid="sign-in-button"]');
      // If button exisits, click it.
      if (btn) {
        btn.click();
        clearInterval(timer);
      }
    } catch (e) {
      // DOM not ready yet, keep waiting
    }
  }, 100);
}
</script>

<button class="btn btn-primary"
        style="background-color:#ffb71c; border-color: black; color: black"
        onclick="launchFluent()">Connect
</button>